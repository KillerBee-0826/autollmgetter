project_name         = "claude-news-analyzer"
aws_region           = "ap-northeast-1"
s3_bucket_name       = "claude-news-analyzer"
lambda_function_name = "claude-news-analyzer"
lambda_layer_name    = "claude-news-analyzer-dependencies"

bedrock_model_id = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
bedrock_region   = "us-east-1"

email_notification_enabled = true
ses_sender_identity        = "sender@example.com"
create_ses_identity        = false
presign_secret_name        = "claude-news-analyzer/s3-presign-user"

enable_public_html_cloudfront = true
public_html_prefix            = "public"
cloudfront_price_class        = "PriceClass_200"
cloudfront_default_ttl        = 300
cloudfront_max_ttl            = 86400
