          <mxGeometry height="30" width="130" x="60" y="530" as="geometry" />
        </mxCell>
        <mxCell id="desc1" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color:#E7157B&quot;&gt;① Amazon EventBridge&lt;/b&gt;&lt;br&gt;　日次・週次・月次・四半期の4種類のcronスケジュールで&lt;br&gt;　Lambda を定期起動。analysis_type をイベントで渡す。" vertex="1">
          <mxGeometry height="60" width="340" x="60" y="560" as="geometry" />
        </mxCell>
        <mxCell id="desc2" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color: rgb(237, 113, 0);&quot;&gt;② AWS Lambda&lt;/b&gt;&lt;br&gt;　ニュース収集→Bedrock分析→S3保存→メール通知の&lt;br&gt;　一連のバッチ処理を実行するメインの実行環境。&lt;div&gt;　※ニュースサイトログイン未実装&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="290" x="60" y="620" as="geometry" />
        </mxCell>
        <mxCell id="desc3" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color: rgb(63, 134, 36);&quot;&gt;③ Amazon S3&lt;/b&gt;&lt;br&gt;　設定ファイル・分析プロンプト・生成レポート（MD/HTML）・&lt;br&gt;　CloudFront公開用HTMLの保存先。" vertex="1">
          <mxGeometry height="50" width="340" x="60" y="680" as="geometry" />
        </mxCell>
        <mxCell id="desc4" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color: rgb(1, 168, 141);&quot;&gt;④ Amazon Bedrock&lt;/b&gt;&lt;br&gt;　Claude モデルによる技術ニュースの分析・要約・&lt;br&gt;　期間集約レポートの生成を実行。&lt;div&gt;　model:us.anthropic.claude-haiku-4-5-20251001-v1:0&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="290" x="440" y="560" as="geometry" />
        </mxCell>
        <mxCell id="desc5" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color: rgb(140, 79, 255);&quot;&gt;⑤ Amazon CloudFront&lt;/b&gt;&lt;br&gt;　OAC経由でS3 public/ 配下のHTMLレポートを&lt;br&gt;　HTTPS配信。&lt;div&gt;&amp;nbsp; &amp;nbsp;手動作成のdistribution。(FreePlan利用のため)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="440" y="620" as="geometry" />
        </mxCell>
        <mxCell id="desc6" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color:#E7157B&quot;&gt;⑥ Amazon SES&lt;/b&gt;&lt;br&gt;　分析完了時にCloudFront URLを含む通知メールを&lt;br&gt;　受信者へ送信。" vertex="1">
          <mxGeometry height="60" width="310" x="440" y="680" as="geometry" />
        </mxCell>
        <mxCell id="desc7" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" value="&lt;b style=&quot;color:#E7157B&quot;&gt;⑦ CloudWatch Logs&lt;/b&gt;&lt;br&gt;　Lambda実行ログの保管・モニタリング。&lt;br&gt;　エラー原因の追跡に使用。" vertex="1">
          <mxGeometry height="60" width="310" x="770" y="570" as="geometry" />
        </mxCell>
